<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="!(loc.ProductName)"
      Manufacturer="adogecheems"
      Version="$(var.ProductVersion)"
      UpgradeCode="7C0319E4-768D-4C48-A41C-25F0D677EA89"
      Scope="perMachine"
      Compressed="yes">
    <MajorUpgrade
        AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="!(loc.DowngradeErrorMessage)" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="WINDOWS_BUILD">
      <RegistrySearch
          Id="SearchWindowsBuild"
          Root="HKLM"
          Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
          Name="CurrentBuildNumber"
          Type="raw"
          Bitness="always64" />
    </Property>

    <Launch
        Condition="VersionNT64 AND WINDOWS_BUILD &gt;= 10240"
        Message="!(loc.LaunchConditionMessage)" />

    <Property Id="ARPHELPLINK" Value="https://github.com/adogecheems/panasonic-posture-manager" />
    <Property Id="ARPCOMMENTS" Value="!(loc.ArpComments)" />
    <Property Id="ARPPRODUCTICON" Value="ProductIcon.ico" />
    <Property Id="DISABLEADVTSHORTCUTS" Value="1" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="!(loc.ExitDialogOptionalText)" />
    <Property Id="MainPathErrorFormat" Value="!(loc.MainPathErrorFormat)" />
    <Property Id="MainPathErrorNetwork" Value="!(loc.MainPathErrorNetwork)" />
    <Property Id="MainPathErrorProtected" Value="!(loc.MainPathErrorProtected)" />
    <Property Id="MainPathErrorRoot" Value="!(loc.MainPathErrorRoot)" />
    <Property Id="MainPathErrorLength" Value="!(loc.MainPathErrorLength)" />
    <Property Id="MainPathErrorReparse" Value="!(loc.MainPathErrorReparse)" />
    <Property Id="MainPathErrorOccupied" Value="!(loc.MainPathErrorOccupied)" />
    <Property Id="SLATE_CONFIGURED_BY_PRODUCT">
      <RegistrySearch
          Id="SearchConfiguredSlate"
          Root="HKLM"
          Key="SOFTWARE\PanasonicPostureManager\Setup"
          Name="SlateExclusiveConfigured"
          Type="raw"
          Bitness="always64" />
    </Property>

    <SetProperty
        Id="ConfigureSlate"
        Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#ServiceSlateConfigScript]&quot; -Action Install"
        Before="ConfigureSlate"
        Sequence="execute" />
    <CustomAction
        Id="ConfigureSlate"
        BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
        DllEntry="WixQuietExec"
        Execute="deferred"
        Impersonate="no"
        Return="check" />
    <SetProperty
        Id="ConfigureHardwareService"
        Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#ServiceHardwareServiceScript]&quot; -Action Configure"
        Before="ConfigureHardwareService"
        Sequence="execute" />
    <CustomAction
        Id="ConfigureHardwareService"
        BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
        DllEntry="WixQuietExec"
        Execute="deferred"
        Impersonate="no"
        Return="check" />
    <SetProperty
        Id="RollbackSlate"
        Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#ServiceSlateConfigScript]&quot; -Action Remove"
        Before="RollbackSlate"
        Sequence="execute" />
    <CustomAction
        Id="RollbackSlate"
        BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
        DllEntry="WixQuietExec"
        Execute="rollback"
        Impersonate="no"
        Return="ignore" />
    <SetProperty
        Id="RestoreSlate"
        Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#ServiceSlateConfigScript]&quot; -Action Remove"
        Before="RestoreSlate"
        Sequence="execute" />
    <CustomAction
        Id="RestoreSlate"
        BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
        DllEntry="WixQuietExec"
        Execute="deferred"
        Impersonate="no"
        Return="check" />
    <SetProperty
        Id="LocalizeStartMenu"
        Value="&quot;[#ServicePythonHardwareExe]&quot; -B -I -m panasonic_posture.windows.shortcut_locale --install --language-id [UserLanguageID]"
        Before="LocalizeStartMenu"
        Sequence="execute" />
    <CustomAction
        Id="LocalizeStartMenu"
        BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
        DllEntry="WixQuietExec"
        Execute="deferred"
        Impersonate="no"
        Return="ignore" />
    <SetProperty
        Id="RepairStartMenuShortcut"
        Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#ServiceShortcutRepairScript]&quot; -LanguageId [UserLanguageID] -InstallFolder &quot;[INSTALLFOLDER]&quot;"
        Before="RepairStartMenuShortcut"
        Sequence="execute" />
    <CustomAction
        Id="RepairStartMenuShortcut"
        BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
        DllEntry="WixQuietExec"
        Execute="deferred"
        Impersonate="no"
        Return="check" />
    <SetProperty
        Id="RemoveLocalizedStartMenu"
        Value="&quot;[#ServicePythonHardwareExe]&quot; -B -I -m panasonic_posture.windows.shortcut_locale --remove --language-id [UserLanguageID]"
        Before="RemoveLocalizedStartMenu"
        Sequence="execute" />
    <CustomAction
        Id="RemoveLocalizedStartMenu"
        BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
        DllEntry="WixQuietExec"
        Execute="deferred"
        Impersonate="no"
        Return="ignore" />
    <Binary
        Id="MainPathActions"
        SourceFile="$(var.ProjectRoot)/packaging/windows/msi/main-path-actions.js" />
    <CustomAction
        Id="CompleteAndValidateMainPath"
        BinaryRef="MainPathActions"
        JScriptCall="CompleteAndValidateMainPath"
        Execute="immediate"
        Impersonate="yes"
        Return="check" />
    <CustomAction
        Id="EnforceMainPath"
        BinaryRef="MainPathActions"
        JScriptCall="EnforceMainPath"
        Execute="immediate"
        Impersonate="yes"
        Return="check" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="PanasonicPostureManager" />
      <Directory Id="SERVICEINSTALLFOLDER" Name="PanasonicPostureManagerService" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Panasonic 2-in-1 Tablet Posture Management Tool" />
    </StandardDirectory>

    <Icon
        Id="ProductIcon.ico"
        SourceFile="$(var.ProjectRoot)/data/assets/work.mmoe.panasonic.PostureManager.ico" />

    <Feature Id="Complete" Title="!(loc.FeatureTitle)" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="PayloadComponents" />
    </Feature>

    <ui:WixUI Id="WixUI_PostureInstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <WixVariable
        Id="WixUIBannerBmp"
        Value="$(var.ProjectRoot)/packaging/windows/msi/installer-banner.png" />
    <WixVariable
        Id="WixUIDialogBmp"
        Value="$(var.ProjectRoot)/packaging/windows/msi/installer-dialog.png" />
    <WixVariable
        Id="WixUIInfoIco"
        Value="$(var.ProjectRoot)/packaging/windows/msi/installer-info.png" />
    <WixVariable
        Id="WixUIExclamationIco"
        Value="$(var.ProjectRoot)/packaging/windows/msi/installer-info.png" />

    <InstallExecuteSequence>
      <Custom Action="EnforceMainPath" After="CostFinalize" Condition="NOT REMOVE" />
      <Custom Action="RollbackSlate" Before="ConfigureSlate" Condition="NOT REMOVE" />
      <Custom Action="LocalizeStartMenu" After="CreateShortcuts" Condition="NOT REMOVE" />
      <Custom Action="RepairStartMenuShortcut" After="LocalizeStartMenu" Condition="NOT REMOVE" />
      <Custom Action="ConfigureSlate" After="InstallFiles" Condition="NOT REMOVE" />
      <Custom Action="ConfigureHardwareService" After="InstallServices" Condition="NOT REMOVE" />
      <Custom Action="RemoveLocalizedStartMenu" Before="RestoreSlate"
              Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RestoreSlate" Before="RemoveFiles"
              Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <ScheduleReboot
          After="InstallFinalize"
          Condition="(NOT REMOVE AND SLATE_CONFIGURED_BY_PRODUCT &lt;&gt; &quot;#1&quot;) OR (REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE)" />
    </InstallExecuteSequence>
  </Package>
  <Fragment>
    <UIRef Id="WixUI_ErrorProgressText" />
  </Fragment>
  <?foreach WIXUIARCH in X86;X64;A64 ?>
  <Fragment>
    <UI Id="WixUI_PostureInstallDir_$(WIXUIARCH)">
      <Publish
          Dialog="LicenseAgreementDlg"
          Control="Print"
          Event="DoAction"
          Value="WixUIPrintEula_$(WIXUIARCH)" />
    </UI>
    <UIRef Id="WixUI_PostureInstallDir" />
  </Fragment>
  <?endforeach?>
  <Fragment>
    <UI Id="WixUI_PostureInstallDir">
      <!-- Microsoft YaHei UI has native CJK metrics on supported Windows
           versions. Tahoma falls back to mismatched glyph metrics and can
           overlap wrapped Chinese copy at high DPI. -->
      <TextStyle Id="WixUI_Font_Normal" FaceName="Microsoft YaHei UI" Size="9" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Microsoft YaHei UI" Size="14" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Microsoft YaHei UI" Size="11" Bold="yes" />

      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <Property Id="ARPNOMODIFY" Value="1" />

      <DialogRef Id="BrowseDlg" />
      <DialogRef Id="DiskCostDlg" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="InvalidMainPathDlg" />
      <DialogRef Id="PostureInstallDirDlg" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />

      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="LicenseAgreementDlg" Condition="NOT Installed" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="Installed AND PATCH" />

      <Publish Dialog="LicenseAgreementDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" />
      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="PostureInstallDirDlg" Condition="LicenseAccepted = &quot;1&quot;" />

      <Publish Dialog="PostureInstallDirDlg" Control="Back" Event="NewDialog" Value="LicenseAgreementDlg" />
      <Publish Dialog="PostureInstallDirDlg" Control="Next" Event="DoAction" Value="CompleteAndValidateMainPath" Order="1" />
      <Publish Dialog="PostureInstallDirDlg" Control="Next" Event="SpawnDialog" Value="InvalidMainPathDlg" Order="2" Condition="MAIN_PATH_VALID &lt;&gt; &quot;1&quot;" />
      <Publish Dialog="PostureInstallDirDlg" Control="Next" Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="3" Condition="MAIN_PATH_VALID = &quot;1&quot;" />
      <Publish Dialog="PostureInstallDirDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="4" Condition="MAIN_PATH_VALID = &quot;1&quot;" />
      <Publish Dialog="PostureInstallDirDlg" Control="ChangeFolder" Property="_BrowseProperty" Value="[WIXUI_INSTALLDIR]" Order="1" />
      <Publish Dialog="PostureInstallDirDlg" Control="ChangeFolder" Event="SpawnDialog" Value="BrowseDlg" Order="2" />

      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="PostureInstallDirDlg" Order="1" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2" Condition="Installed AND NOT PATCH" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" Condition="Installed AND PATCH" />

      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />
    </UI>
    <UI Id="WixUI_PosturePathDialogs">
      <Dialog Id="PostureInstallDirDlg" X="50" Y="50" Width="370" Height="270" Title="[ProductName] 安装程序">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Text="!(loc.WixUINext)" TabSkip="no" Default="yes" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" TabSkip="no" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Text="!(loc.WixUICancel)" TabSkip="no" Cancel="yes">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" Text="WixUI_Bmp_Banner" Disabled="yes" TabSkip="no" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" Disabled="yes" TabSkip="yes" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" Disabled="yes" TabSkip="yes" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="300" Height="18" Transparent="yes" NoPrefix="yes" Text="!(loc.InstallDirDlgTitle)" TabSkip="yes" />
        <Control Id="Description" Type="Text" X="25" Y="24" Width="330" Height="18" Transparent="yes" NoPrefix="yes" Text="!(loc.InstallDirDlgDescription)" TabSkip="yes" />
        <Control Id="FolderLabel" Type="Text" X="20" Y="58" Width="325" Height="36" Text="!(loc.InstallDirDlgFolderLabel)" NoPrefix="yes" TabSkip="yes" />
        <Control Id="Folder" Type="PathEdit" X="20" Y="104" Width="320" Height="18" Indirect="yes" Property="WIXUI_INSTALLDIR" TabSkip="no" />
        <Control Id="ChangeFolder" Type="PushButton" X="20" Y="127" Width="64" Height="18" Text="!(loc.PostureChangeFolder)" TabSkip="no" />
      </Dialog>
      <Dialog Id="InvalidMainPathDlg" Width="370" Height="270" Title="!(loc.MainPathDialogTitle)">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="300" Height="18" Transparent="yes" NoPrefix="yes" Text="!(loc.MainPathDialogTitle)" />
        <Control Id="Description" Type="Text" X="25" Y="24" Width="320" Height="18" Transparent="yes" NoPrefix="yes" Text="!(loc.MainPathDialogDescription)" />
        <Control Id="Message" Type="Text" X="25" Y="70" Width="320" Height="120" NoPrefix="yes" Text="[MAIN_PATH_ERROR]" />
        <Control Id="Back" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUIBack)">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>
    </UI>
    <UIRef Id="WixUI_Common" />
  </Fragment>
</Wix>
