<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="Panasonic 2-in-1 Tablet Posture Management Tool"
      Manufacturer="adogecheems"
      Version="$(var.ProductVersion)"
      UpgradeCode="7C0319E4-768D-4C48-A41C-25F0D677EA89"
      Scope="perMachine"
      Compressed="yes">
    <MajorUpgrade
        AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Panasonic 2-in-1 Tablet Posture Management Tool is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="WINDOWS_BUILD">
      <RegistrySearch
          Id="SearchWindowsBuild"
          Root="HKLM"
          Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
          Name="CurrentBuildNumber"
          Type="raw"
          Bitness="always64" />
    </Property>

    <Launch
        Condition="VersionNT64 AND WINDOWS_BUILD &gt;= 10240"
        Message="Panasonic 2-in-1 Tablet Posture Management Tool requires 64-bit Windows 10 or later." />

    <Property Id="ARPHELPLINK" Value="https://github.com/adogecheems/panasonic-posture-manager" />
    <Property Id="ARPCOMMENTS" Value="Panasonic 2-in-1 tablet posture, direction and hardware service." />
    <Property Id="ARPPRODUCTICON" Value="ProductIcon.ico" />
    <Property Id="SLATE_CONFIGURED_BY_PRODUCT">
      <RegistrySearch
          Id="SearchConfiguredSlate"
          Root="HKLM"
          Key="SOFTWARE\PanasonicPostureManager\Setup"
          Name="SlateExclusiveConfigured"
          Type="raw"
          Bitness="always64" />
    </Property>

    <SetProperty
        Id="ConfigureSlate"
        Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#SlateConfigScript]&quot; -Action Install"
        Before="ConfigureSlate"
        Sequence="execute" />
    <CustomAction
        Id="ConfigureSlate"
        BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
        DllEntry="WixQuietExec"
        Execute="deferred"
        Impersonate="no"
        Return="check" />
    <SetProperty
        Id="ConfigureHardwareService"
        Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#HardwareServiceScript]&quot; -Action Configure"
        Before="ConfigureHardwareService"
        Sequence="execute" />
    <CustomAction
        Id="ConfigureHardwareService"
        BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
        DllEntry="WixQuietExec"
        Execute="deferred"
        Impersonate="no"
        Return="check" />
    <SetProperty
        Id="RollbackSlate"
        Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#SlateConfigScript]&quot; -Action Remove"
        Before="RollbackSlate"
        Sequence="execute" />
    <CustomAction
        Id="RollbackSlate"
        BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
        DllEntry="WixQuietExec"
        Execute="rollback"
        Impersonate="no"
        Return="ignore" />
    <SetProperty
        Id="RestoreSlate"
        Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#SlateConfigScript]&quot; -Action Remove"
        Before="RestoreSlate"
        Sequence="execute" />
    <CustomAction
        Id="RestoreSlate"
        BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
        DllEntry="WixQuietExec"
        Execute="deferred"
        Impersonate="no"
        Return="check" />
    <SetProperty
        Id="LocalizeStartMenu"
        Value="&quot;[#PythonHardwareExe]&quot; -B -I -m panasonic_posture.windows.shortcut_locale --install --language-id [UserLanguageID]"
        Before="LocalizeStartMenu"
        Sequence="execute" />
    <CustomAction
        Id="LocalizeStartMenu"
        BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
        DllEntry="WixQuietExec"
        Execute="deferred"
        Impersonate="no"
        Return="ignore" />
    <SetProperty
        Id="RemoveLocalizedStartMenu"
        Value="&quot;[#PythonHardwareExe]&quot; -B -I -m panasonic_posture.windows.shortcut_locale --remove --language-id [UserLanguageID]"
        Before="RemoveLocalizedStartMenu"
        Sequence="execute" />
    <CustomAction
        Id="RemoveLocalizedStartMenu"
        BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
        DllEntry="WixQuietExec"
        Execute="deferred"
        Impersonate="no"
        Return="ignore" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="PanasonicPostureManager" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Panasonic 2-in-1 Tablet Posture Management Tool" />
    </StandardDirectory>

    <Icon
        Id="ProductIcon.ico"
        SourceFile="$(var.ProjectRoot)/data/assets/work.mmoe.panasonic.PostureManager.ico" />

    <Feature Id="Complete" Title="Panasonic 2-in-1 Tablet Posture Management Tool" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="PayloadComponents" />
    </Feature>

    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.ProjectRoot)/packaging/windows/msi/LICENSE.rtf" />

    <InstallExecuteSequence>
      <Custom Action="RollbackSlate" Before="ConfigureSlate" Condition="NOT REMOVE" />
      <Custom Action="LocalizeStartMenu" Before="ConfigureSlate" Condition="NOT REMOVE" />
      <Custom Action="ConfigureSlate" After="InstallFiles" Condition="NOT REMOVE" />
      <Custom Action="ConfigureHardwareService" After="InstallServices" Condition="NOT REMOVE" />
      <Custom Action="RemoveLocalizedStartMenu" Before="RestoreSlate"
              Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RestoreSlate" Before="RemoveFiles"
              Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <ScheduleReboot
          After="InstallFinalize"
          Condition="(NOT REMOVE AND SLATE_CONFIGURED_BY_PRODUCT &lt;&gt; &quot;#1&quot;) OR (REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE)" />
    </InstallExecuteSequence>
  </Package>
</Wix>
