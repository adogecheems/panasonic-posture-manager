<WixLocalization Culture="zh-CN" Codepage="936"
    xmlns="http://wixtoolset.org/schemas/v4/wxl">
  <String Id="ProductName" Value="松下二合一平板电脑姿态管理工具" />
  <String Id="FeatureTitle" Value="松下二合一平板电脑姿态管理工具" />
  <String Id="ArpComments" Value="松下二合一平板姿态、方向与硬件服务。" />
  <String Id="ServiceDisplayName" Value="[ProductName] 硬件服务" />
  <String Id="ServiceDescription" Value="为 [ProductName] 提供经过身份验证的 LocalSystem 硬件端点。" />
  <String Id="ShortcutDescription" Value="打开 [ProductName]" />
  <String Id="DowngradeErrorMessage" Value="已安装较新版本的 [ProductName]。" />
  <String Id="LaunchConditionMessage" Value="[ProductName] 需要 64 位 Windows 10 或更高版本。" />
  <String Id="WelcomeDlgTitle" Overridable="yes"
      Value="{\WixUI_Font_Bigger}欢迎安装 [ProductName]" />
  <String Id="WelcomeDlgDescription"
      Value="安装程序将帮助你在计算机上安装此应用。点击“下一步”继续。" />
  <String Id="InstallDirDialogTitle" Value="[ProductName] 安装程序" />
  <String Id="InstallDirDlgTitle" Overridable="yes"
      Value="{\WixUI_Font_Title}选择安装位置" />
  <String Id="InstallDirDlgDescription"
      Value="选择此应用的安装位置。" />
  <String Id="InstallDirDlgFolderLabel"
      Value="默认位置适合大多数用户；如需安装到其他位置，请点击“更改”。" />
  <String Id="PostureChangeFolder" Value="更改(&amp;C)..." />
  <String Id="MainPathDialogTitle"
      Value="{\WixUI_Font_Title}无法使用此安装位置" />
  <String Id="MainPathDialogDescription"
      Value="请选择其他文件夹后重试。" />
  <String Id="MainPathErrorFormat"
      Value="请输入本地绝对路径，例如 D:\Apps。不要使用相对路径、UNC 路径或无效字符。" />
  <String Id="MainPathErrorNetwork"
      Value="主程序只能安装到本地固定磁盘。" />
  <String Id="MainPathErrorProtected"
      Value="不能安装到 Windows、系统目录或固定硬件服务目录。" />
  <String Id="MainPathErrorRoot"
      Value="请选择磁盘中的文件夹，不要直接选择磁盘根目录。" />
  <String Id="MainPathErrorLength"
      Value="安装路径过长，请改选更短的上级目录。" />
  <String Id="MainPathErrorReparse"
      Value="路径中包含目录联接、符号链接或其他重解析点，请选择普通目录。" />
  <String Id="MainPathErrorOccupied"
      Value="目标目录已有其他文件，且不是本工具的安装目录。请选择其他上级目录。" />
  <String Id="VerifyReadyDlgInstallTitle" Overridable="yes"
      Value="{\WixUI_Font_Title}确认安装 [ProductName]" />
  <String Id="VerifyReadyDlgInstallText"
      Value="点击“确认安装”开始安装。如需更改安装位置，请点击“上一步”。" />
  <String Id="VerifyReadyDlgInstall" Overridable="yes" Value="确认安装" />
  <String Id="MaintenanceWelcomeDlgTitle" Overridable="yes"
      Value="{\WixUI_Font_Bigger}维护或卸载 [ProductName]" />
  <String Id="MaintenanceWelcomeDlgDescription"
      Value="你可以使用此安装向导修复当前安装，或从这台电脑中卸载 [ProductName]。点击“下一步”继续。" />
  <String Id="MaintenanceTypeDlgTitle" Overridable="yes"
      Value="{\WixUI_Font_Title}选择操作" />
  <String Id="MaintenanceTypeDlgDescription"
      Value="修复已安装的应用与硬件服务，或卸载 [ProductName] 并恢复系统设置。" />
  <String Id="MaintenanceTypeDlgRepairText"
      Value="重新安装缺失或损坏的文件，并恢复硬件服务配置。" />
  <String Id="MaintenanceTypeDlgRemoveButton" Overridable="yes"
      Value="卸载(&amp;U)" />
  <String Id="MaintenanceTypeDlgRemoveButtonTooltip"
      Value="从这台电脑中卸载 [ProductName]。" />
  <String Id="MaintenanceTypeDlgRemoveText"
      Value="移除应用与硬件服务，并恢复安装前的系统设置。" />
  <String Id="VerifyReadyDlgRemoveTitle" Overridable="yes"
      Value="{\WixUI_Font_Title}确认卸载 [ProductName]" />
  <String Id="VerifyReadyDlgRemoveText"
      Value="点击“卸载”将移除应用与硬件服务，并恢复安装前的屏幕方向、旋转锁和平板指示器配置。完成后可能需要重启 Windows。" />
  <String Id="VerifyReadyDlgRemove" Overridable="yes" Value="卸载" />
  <String Id="ProgressDlgTitleRemoving" Overridable="yes"
      Value="{\WixUI_Font_Title}正在卸载 [ProductName]" />
  <String Id="ProgressDlgTextRemoving"
      Value="正在停止硬件服务并恢复显示与平板指示器配置，请稍候。" />
  <String Id="ExitDialogInstallTitle"
      Value="{\WixUI_Font_Bigger}松下二合一平板电脑姿态管理工具 设置完成" />
  <String Id="ExitDialogInstallDescription"
      Value="应用与硬件服务已准备就绪。" />
  <String Id="ExitDialogRemoveTitle"
      Value="{\WixUI_Font_Bigger}已卸载松下二合一平板电脑姿态管理工具" />
  <String Id="ExitDialogRemoveDescription"
      Value="应用与硬件服务已从这台电脑中移除。" />
  <String Id="ExitDialogOptionalText"
      Value="安装完成后可能需要重启 Windows，重启后设置才会生效。" />
  <String Id="ExitDialogRemoveOptionalText"
      Value="卸载完成。如果硬件服务或平板指示器配置未恢复，请重启 Windows。" />
  <!-- Keep all banner copy in the 220-DLU content column to the right of
       the brand panel. Ready and progress titles reserve two lines for the
       English product name while remaining inside the 44-DLU banner. -->
  <UI Dialog="LicenseAgreementDlg" Control="Title" X="135" Width="220" RightAligned="yes" />
  <UI Dialog="LicenseAgreementDlg" Control="Description" X="135" Width="220" RightAligned="yes" />
  <UI Dialog="BrowseDlg" Control="Title" X="135" Width="220" RightAligned="yes" />
  <UI Dialog="BrowseDlg" Control="Description" X="135" Width="220" RightAligned="yes" />
  <UI Dialog="MaintenanceTypeDlg" Control="Title" X="135" Width="220" RightAligned="yes" />
  <UI Dialog="MaintenanceTypeDlg" Control="Description" X="135" Width="220" RightAligned="yes" />
  <UI Dialog="DiskCostDlg" Control="Title" X="135" Width="220" RightAligned="yes" />
  <UI Dialog="DiskCostDlg" Control="Description" X="135" Width="220" RightAligned="yes" />
  <UI Dialog="FilesInUse" Control="Title" X="135" Width="220" RightAligned="yes" />
  <UI Dialog="FilesInUse" Control="Description" X="135" Width="220" RightAligned="yes" />
  <UI Dialog="MsiRMFilesInUse" Control="Title" X="135" Width="220" RightAligned="yes" />
  <UI Dialog="MsiRMFilesInUse" Control="Description" X="135" Width="220" RightAligned="yes" />
  <UI Dialog="OutOfRbDiskDlg" Control="Title" X="135" Width="220" RightAligned="yes" />
  <UI Dialog="OutOfRbDiskDlg" Control="Description" X="135" Width="220" RightAligned="yes" />
  <UI Dialog="OutOfDiskDlg" Control="Title" X="135" Width="220" RightAligned="yes" />
  <UI Dialog="OutOfDiskDlg" Control="Description" X="135" Width="220" RightAligned="yes" />
  <UI Dialog="ExitDialog" Control="Title" Text="[POSTURE_EXIT_TITLE]" />
  <UI Dialog="ExitDialog" Control="Description" Text="[POSTURE_EXIT_DESCRIPTION]" />
  <UI Dialog="VerifyReadyDlg" Control="InstallTitle" X="135" Y="6" Width="220" Height="32" RightAligned="yes" />
  <UI Dialog="VerifyReadyDlg" Control="ChangeTitle" X="135" Y="6" Width="220" Height="32" RightAligned="yes" />
  <UI Dialog="VerifyReadyDlg" Control="RepairTitle" X="135" Y="6" Width="220" Height="32" RightAligned="yes" />
  <UI Dialog="VerifyReadyDlg" Control="RemoveTitle" X="135" Y="6" Width="220" Height="32" RightAligned="yes" />
  <UI Dialog="VerifyReadyDlg" Control="UpdateTitle" X="135" Y="6" Width="220" Height="32" RightAligned="yes" />
  <UI Dialog="ProgressDlg" Control="TitleInstalling" X="135" Y="6" Width="220" Height="32" RightAligned="yes" />
  <UI Dialog="ProgressDlg" Control="TitleChanging" X="135" Y="6" Width="220" Height="32" RightAligned="yes" />
  <UI Dialog="ProgressDlg" Control="TitleRepairing" X="135" Y="6" Width="220" Height="32" RightAligned="yes" />
  <UI Dialog="ProgressDlg" Control="TitleRemoving" X="135" Y="6" Width="220" Height="32" RightAligned="yes" />
  <UI Dialog="ProgressDlg" Control="TitleUpdating" X="135" Y="6" Width="220" Height="32" RightAligned="yes" />
  <!-- The default 10-DLU status controls clip the 9pt YaHei line. Reserve
       15 DLU and keep a three-DLU gap before the progress bar. -->
  <UI Dialog="ProgressDlg" Control="StatusLabel" Y="100" Height="15" />
  <UI Dialog="ProgressDlg" Control="ActionText" Y="100" Height="15" />
  <UI Dialog="ProgressDlg" Control="ProgressBar" Y="118" Height="10" />
</WixLocalization>
