msgid "Tent"
msgstr "帐篷"

msgid "Stand"
msgstr "支架"

msgid "Tablet"
msgstr "平板"

msgid "Current posture"
msgstr "当前姿态"

msgid "Settings"
msgstr "设置"

msgid "Panasonic 2-in-1 Tablet Posture Management Tool"
msgstr "松下二合一平板电脑姿态管理工具"

msgid "Connecting to background service…"
msgstr "正在连接后台服务…"

msgid "Background service unavailable"
msgstr "后台服务未连接"

msgid "Enter tent mode"
msgstr "进入帐篷模式"

msgid "Enter stand mode"
msgstr "进入支架模式"

msgid "Retry"
msgstr "重试"

msgid "The tablet switch is unavailable. Restart the background service if this continues."
msgstr "无法读取平板开关状态。若持续出现，请重启后台服务。"

msgid "No posture data is available. Keep the device still; switching will resume automatically."
msgstr "暂时没有姿态数据，请将设备静置，恢复后会自动继续切换。"

msgid "Switching is taking longer than usual. Please wait or choose another mode in Settings."
msgstr "切换耗时较长，请稍候，或到设置中选择其他模式。"

msgid "Retrying…"
msgstr "正在重试…"

msgid "Mode change failed"
msgstr "模式切换失败"

msgid "Unable to change settings"
msgstr "无法修改设置"

msgid "Automatic mode"
msgstr "自动模式"

msgid "You can still select tent mode manually when this is off."
msgstr "关闭后仍可手动选择帐篷模式。"

msgid "Tent mode notification"
msgstr "帐篷模式提示"

msgid "Ask before switching to tent mode when the base is upright"
msgstr "底座立起时，询问是否进入帐篷模式"

msgid "Stand mode notification"
msgstr "支架模式提示"

msgid "Ask before switching to stand mode when the base is folded back"
msgstr "底座倒置平放时，询问是否进入支架模式"

msgid "Sensor"
msgstr "传感器"

msgid "Sensor calibration"
msgstr "传感器校准"

msgid "Place the device in laptop form on a flat desk, then calibrate."
msgstr "将设备以笔记本形态平放在桌面上，然后进行校准。"

msgid "A custom flat-desk reference is in use."
msgstr "当前使用自定义的桌面水平基准。"

msgid "Calibrate"
msgstr "校准"

msgid "Calibrate sensor"
msgstr "校准传感器"

msgid "Calibrate sensor?"
msgstr "校准传感器？"

msgid "Place the device in laptop form on a flat, stable desk and wait about two seconds before confirming. Its current direction will become the level reference."
msgstr "请将设备以笔记本形态平放在稳定的桌面上，静置约两秒后再确认。当前方向将作为水平基准。"

msgid "Cancel"
msgstr "取消"

msgid "Calibrating…"
msgstr "正在校准…"

msgid "Resetting…"
msgstr "正在恢复…"

msgid "Reset"
msgstr "恢复默认"

msgid "Reset sensor calibration"
msgstr "恢复默认传感器校准"

msgid "Sensor direction calibrated."
msgstr "传感器方向已校准。"

msgid "Sensor direction reset."
msgstr "传感器校准已恢复默认。"

msgid "Unable to calibrate sensor"
msgstr "无法校准传感器"

msgid "Unable to reset sensor calibration"
msgstr "无法恢复传感器校准默认值"

msgid "Mode selection"
msgstr "模式选择"

msgid "Automatic"
msgstr "自动"

msgid "Switch automatically to suit the current posture"
msgstr "根据设备姿态自动切换"

msgid "Best for typing and precise work"
msgstr "适合打字和精细操作"

msgid "Turns the screen upside down and disables the built-in keyboard and touchpad"
msgstr "倒转屏幕，停用内置键盘和触控板"

msgid "Keeps the screen upright and disables the built-in keyboard and touchpad"
msgstr "保持屏幕正向，停用内置键盘和触控板"

msgid "Lets the screen rotate and disables the built-in keyboard and touchpad"
msgstr "允许屏幕自动旋转，停用内置键盘和触控板"

msgid "About"
msgstr "关于"

msgid "Author"
msgstr "作者"

msgid "Version"
msgstr "版本"

msgid "GitHub"
msgstr "GitHub"

msgid "Visit repository"
msgstr "访问仓库"

msgid "Let's note is a trademark of Panasonic Corporation. The author does not claim any rights to the trademark and is not associated with it."
msgstr "Let's note 是松下电器株式会社（Panasonic Corporation）的商标；本项目作者不主张该商标的任何权利，亦与该商标无关联。"

msgid "Tap to enable tent mode"
msgstr "轻触以启用帐篷模式"

msgid "Enable tent mode"
msgstr "启用帐篷模式"

msgid "Tap to enable stand mode"
msgstr "轻触以启用支架模式"

msgid "Enable stand mode"
msgstr "启用支架模式"

msgid "Waiting for the desktop to get ready…"
msgstr "正在等待桌面功能就绪…"

msgid "This model does not support automatic mode changes."
msgstr "当前机型不支持自动切换模式。"

msgid "Compatibility mode: this model is supported but has not been individually validated."
msgstr "兼容模式：当前机型可用，但尚未逐机验证。"

msgid "This mode is not available right now."
msgstr "当前无法选择该模式。"

msgid "Please switch back to the local desktop and try again."
msgstr "请切回本机桌面后重试。"

msgid "The tablet switch currently controls the mode."
msgstr "当前模式由平板开关控制。"

msgid "The posture prompt has expired. Wait for it to appear again."
msgstr "姿态提示已失效，请等待提示再次出现。"

msgid "The setting could not be saved. Please try again."
msgstr "设置保存失败，请重试。"

msgid "The internal keyboard and touchpad could not be controlled. Please try again."
msgstr "暂时无法控制内置键盘和触控板，请重试。"

msgid "Internal input control stopped. Please try again."
msgstr "内置输入控制已停止，请重试。"

msgid "Internal input control stopped responding. Please try again."
msgstr "内置输入控制无响应，请重试。"

msgid "The internal keyboard and touchpad could not be disabled. Please try again."
msgstr "暂时无法停用内置键盘和触控板，请重试。"

msgid "The tablet switch state could not be restored. Restart the service if input behaves unexpectedly."
msgstr "平板开关状态恢复失败；如键盘或触控板异常，请重启服务。"

msgid "No posture data is available right now."
msgstr "当前无法获取姿态数据。"

msgid "Place the device in laptop form on a flat desk and hold it still for about two seconds, then try again."
msgstr "请将设备以笔记本形态平放在桌面上，静置约两秒后再试。"

msgid "This screen arrangement cannot be rotated. Please adjust the display settings."
msgstr "当前屏幕布局无法旋转，请调整显示设置。"

msgid "The external display arrangement does not allow this mode."
msgstr "当前外接显示器布局不允许该模式。"

msgid "The screen rotation could not be applied. Please try again."
msgstr "屏幕方向调整失败，请重试。"

msgid "The rotation lock could not be changed. Please try again."
msgstr "旋转锁定切换失败，请重试。"

msgid "Screen rotation is not available right now."
msgstr "暂时无法调整屏幕方向。"

msgid "This display mode is not supported."
msgstr "不支持该显示模式。"

msgid "The internal screen changed while applying the mode. Please try again."
msgstr "应用模式时内屏发生变化，请重试。"

msgid "Something went wrong. Please try again."
msgstr "操作失败，请重试。"

msgid "Laptop"
msgstr "笔记本"

msgid "Tent mode"
msgstr "帐篷模式"

msgid "Stand mode"
msgstr "支架模式"

msgid "Appearance"
msgstr "外观"

msgid "Dark"
msgstr "深色"

msgid "Demo preview · Changes stay in this window."
msgstr "演示预览 · 所有更改仅在此窗口中生效。"

msgid "Light"
msgstr "浅色"

msgid "Please try again."
msgstr "请重试。"

msgid "Preview updated"
msgstr "预览已更新"

msgid "System"
msgstr "跟随系统"

msgid "Unable to complete the operation"
msgstr "操作未能完成"

msgid "Windows preview · The backend is not connected yet."
msgstr "Windows 界面预览 · 后台服务尚未接入。"

msgid "Wake from suspend by touch"
msgstr "通过触摸唤醒挂起的电脑"

msgid "Allow the built-in touchscreen to wake this computer when supported by the hardware."
msgstr "在硬件支持时，允许轻触内置屏幕唤醒电脑。"

msgid "Screen and sleep"
msgstr "屏幕与睡眠"

msgid "No supported built-in USB touchscreen is available."
msgstr "当前没有可用于唤醒的内置 USB 触摸屏。"

msgid "Return to automatic"
msgstr "返回自动"

msgid "Detect tent mode automatically"
msgstr "自动识别帐篷模式"
